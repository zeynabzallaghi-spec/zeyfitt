// AI Fitness Coach — اسکیمای پایگاه داده (Prisma + SQLite)
//
// ساختار جدول‌های احراز هویت (user / account / session / verification) مطابق
// قرارداد کتابخانه better-auth است؛ hash رمز عبور در جدول account (providerId = "credential")
// نگهداری می‌شود و هیچ‌گاه متن ساده نیست (bcrypt با cost ۱۲).
//
// جدول FitnessProfile با رابطه یک‌به‌یک و حذف آبشاری به user متصل است.
//
// نکته SQLite: Prisma روی SQLite «لیست اسکالر» ندارد؛ فهرست‌ها (تجهیزات،
// محدودیت‌ها، آلرژی‌ها) به‌صورت رشته JSON ذخیره می‌شوند و در لایه سرویس
// تبدیل (marshal/unmarshal) می‌شوند.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------
// جدول‌های احراز هویت — قرارداد better-auth
// ----------------------------------------

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      session[]
  accounts      account[]
  fitnessProfile FitnessProfile?
  weightEntries weightEntry[]
  workoutPlans  WorkoutPlan[]
  nutritionPlans NutritionPlan[]
  workoutSessions WorkoutSession[]
  assistantConversations AssistantConversation[]
  foodLogEntries FoodLogEntry[]
}

model account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  id             String    @id
  userId         String
  token          String    @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  impersonatedBy String?
  user           user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ----------------------------------------
// پروفایل تناسب اندام — یک‌به‌یک با user
// ----------------------------------------

model FitnessProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  // هویت نمایشی
  displayName         String
  // مشخصات بدنی
  age                 Int?
  gender              String? // male | female | undisclosed (اختیاری — برای فرمول‌های آینده)
  heightCm            Float?
  weightKg            Float?
  bodyFat             Float? // اختیاری — در صورت اطلاع کاربر
  // هدف و سطح
  goal                String? // fat_loss | muscle_gain | strength | maintain | fitness
  experience          String? // beginner | intermediate | advanced
  trainingDaysPerWeek Int? // ۱ تا ۷
  sessionMinutes      Int? // مدت هر جلسه (اختیاری)
  // تجهیزات و محدودیت‌ها (محرمانه — فقط برای همین کاربر)
  equipmentJson       String   @default("[]") // آرایه JSON از کدهای تجهیزات
  limitationsJson     String   @default("[]") // آرایه JSON از کدهای محدودیت
  limitationNotes     String? // توضیح آزاد کاربر (اختیاری)
  // ترجیحات غذایی (برای مرحله تغذیه)
  diet                String?
  allergiesJson       String   @default("[]") // آرایه JSON از کدهای آلرژی
  // واحد اندازه‌گیری
  units               String   @default("metric") // metric | imperial
  // زمان‌ها
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------
// اندازه‌گیری وزن — تاریخچه شخصی هر کاربر
// ----------------------------------------
// روند تغییر وزن فقط با اندازه‌گیری‌های تاریخ‌دار معنا دارد؛ وزن لحظه‌ای
// پروفایل جدا نگه داشته می‌شود و با این تاریخچه اشتباه گرفته نمی‌شود.

model weightEntry {
  id         String   @id @default(cuid())
  userId     String
  weightKg   Float
  recordedAt DateTime // تاریخ ثبت اندازه‌گیری (نیمه‌روزها به ابتدای روز)
  createdAt  DateTime @default(now())
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

// ----------------------------------------
// برنامه تمرینی — شخصی و متعلق به یک کاربر
// ----------------------------------------
// هر کاربر می‌تواند چند برنامه داشته باشد؛ در هر لحظه حداکثر یک برنامه
// «فعال» (status = "active") و بقیه «بایگانی» (status = "archived").
// تنظیمات برنامه (ورودی موتور برنامه‌سازی) برای شفافیت و بازتولید آینده
// در خود برنامه ذخیره می‌شود.
//
// نکته SQLite: فهرست‌ها به‌صورت رشته JSON ذخیره می‌شوند (همان الگوی
// FitnessProfile) و در لایه سرویس marshal/unmarshal می‌شوند.

model WorkoutPlan {
  id              String   @id @default(cuid())
  userId          String
  title           String
  // ورودی‌های موتور برنامه‌سازی (snapshot تنظیمات کاربر)
  goal            String // fat_loss | muscle_gain | strength | maintain | fitness
  experience      String // beginner | intermediate | advanced
  daysPerWeek     Int // ۲ تا ۶
  sessionMinutes  Int // ۳۰ | ۴۵ | ۶۰ | ۹۰
  equipmentJson   String   @default("[]") // آرایه شناسه تجهیزات (واژگان بانک حرکات)
  focus           String   @default("all") // all | upper | lower | شناسه دسته
  preferredDaysJson String @default("[]") // آرایه ۰ تا ۶ (شنبه=۰) — اختیاری
  excludedCategoriesJson String @default("[]") // دسته‌های حذف‌شده
  excludedExerciseIdsJson String @default("[]") // حرکات حذف‌شده
  limitationNotes String? // توضیح احتیاطی کاربر (snapshot اختیاری)
  notesJson       String   @default("[]") // راهنماهای عمومی تولیدشده موتور (گرم‌کردن، پیشرفت، …)
  // وضعیت و ردیابی
  status          String   @default("active") // active | archived
  libraryVersion  String // نسخه بانک حرکات هنگام تولید
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  days            WorkoutPlanDay[]
  sessions        WorkoutSession[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// روز یا جلسه تمرینی برنامه — ترتیب در هفته
model WorkoutPlanDay {
  id         String @id @default(cuid())
  planId     String
  order      Int // ترتیب جلسه در هفته (۱ تا N)
  weekday    Int? // ۰ تا ۶ (شنبه=۰) — فقط اگر کاربر روز ترجیحی داشته باشد
  title      String // عنوان جلسه مثل «پوش — سینه و پشت بازو»
  focusLabel String // برچسب تمرکز مثل «بالاتنه»
  estMinutes Int // زمان تقریبی جلسه شامل گرم‌کردن
  plan       WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises  WorkoutPlanExercise[]

  @@index([planId, order])
}

// حرکت داخل جلسه — شناسه پایدار بانک + snapshot حداقلی برای مقاومت در برابر
// تغییر آینده بانک؛ جزئیات کامل اجرا در نمایش از بانک زنده خوانده می‌شود.
model WorkoutPlanExercise {
  id               String @id @default(cuid())
  dayId            String
  order            Int // ترتیب اجرا در جلسه
  exerciseId       String // شناسه پایدار در بانک حرکات
  faName           String // snapshot نام فارسی
  enName           String // snapshot نام انگلیسی
  category         String // snapshot دسته
  coach3dId        String? // snapshot — null یعنی واقعاً بدون انیمیشن (صادقانه)
  sets             Int
  repsMin          Int
  repsMax          Int
  restSeconds      Int
  estimatedMinutes Int
  note             String? // یادداشت کوتاه اجرا (snapshot معرفی حرکت)
  day              WorkoutPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId, order])
}

// ----------------------------------------
// برنامه غذایی — شخصی و متعلق به یک کاربر
// ----------------------------------------
// همان الگوی WorkoutPlan: چند برنامه برای هر کاربر، حداکثر یک برنامه فعال.
// تنظیمات (ورودی موتور) و snapshot کامل محاسبات برای شفافیت و بازتولید
// ذخیره می‌شود؛ مواد داخل وعده‌ها snapshot حداقلی دارند تا تغییر آینده
// بانک مواد غذایی برنامه‌های ذخیره‌شده را ناخواسته تغییر ندهد.
//
// نکته SQLite: فهرست‌ها به‌صورت رشته JSON ذخیره می‌شوند و در لایه سرویس
// marshal/unmarshal می‌شوند (الگوی FitnessProfile و WorkoutPlan).

model NutritionPlan {
  id               String   @id @default(cuid())
  userId           String
  title            String
  // ورودی‌های موتور (snapshot تنظیمات کاربر)
  goal             String // weight_loss | muscle_gain | maintain
  activityLevel    String // sedentary | light | moderate | active | very_active
  dietPattern      String   @default("none") // none | vegetarian | vegan
  mealsPerDay      Int // ۳ تا ۶
  planLength       Int // ۱ یا ۷ (روز)
  allergensJson    String   @default("[]") // آلرژن‌های حذف‌شده
  dislikedFoodIdsJson String @default("[]") // مواد نامطلوب
  budget           String   @default("any") // any | low
  prep             String   @default("any") // any | simple
  estimateJson     String   @default("null") // اطلاعات برآورد استفاده‌شده (سن/قد/وزن/جنسیت)
  // snapshot محاسبات انرژی و درشت‌مغذی — BMR/TDEE/هدف/مکروها/هشدارها
  calcJson         String
  // یادداشت‌های عمومی تولیدشده موتور (محدودیت‌ها، راهنماهای صادقانه)
  notesJson        String   @default("[]")
  // وضعیت و ردیابی نسخه‌ها
  caution          Boolean  @default(false) // حالت احتیاط (زیر ۱۸ یا بارداری) — بدون هدف کالری کاهشی
  status           String   @default("active") // active | archived
  engineVersion    String // نسخه موتور هنگام تولید
  foodsVersion     String // نسخه بانک مواد هنگام تولید
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  days             NutritionPlanDay[]
  foodLogEntries   FoodLogEntry[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// یک روز برنامه غذایی — ترتیب در برنامه (۱ تا ۷)
model NutritionPlanDay {
  id     String @id @default(cuid())
  planId String
  order  Int // ترتیب روز
  plan   NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals  NutritionMeal[]

  @@index([planId, order])
}

// وعده داخل روز — مجموع‌ها از اجزای واقعی محاسبه و هم‌زمان ذخیره می‌شوند
model NutritionMeal {
  id      String @id @default(cuid())
  dayId   String
  order   Int // ترتیب وعده در روز
  type    String // breakfast | snack_am | lunch | snack_pm | dinner | snack_ev
  title   String
  kcal    Int
  protein Float
  carb    Float
  fat     Float
  day     NutritionPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  items   NutritionMealItem[]
  foodLogEntries FoodLogEntry[]

  @@index([dayId, order])
}

// ماده غذایی داخل وعده — شناسه پایدار بانک + مقدار گرم + snapshot ارزش
// تخمینی همان مقدار؛ بازسازی نمایش کاملاً از همین snapshot ممکن است.
model NutritionMealItem {
  id      String @id @default(cuid())
  mealId  String
  order   Int // ترتیب نمایش
  foodId  String // شناسه پایدار در بانک مواد
  faName  String
  enName  String
  group   String
  grams   Int
  kcal    Int
  protein Float
  carb    Float
  fat     Float
  servingHint String // برچسب سهم متداول بانک هنگام تولید
  meal    NutritionMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodLogEntries FoodLogEntry[]

  @@index([mealId, order])
}

// ----------------------------------------
// جلسه تمرینی واقعی — ثبت انجام‌شده‌ها، نه برنامه
// ----------------------------------------
// جلسه فقط با اقدام صریح کاربر («شروع تمرین») ساخته می‌شود و با «پایان تمرین»
// یا «رهاکردن» بسته می‌شود. بازدید از صفحه هرگز جلسه نمی‌سازد.
//
// هر کاربر در هر لحظه حداکثر یک جلسه «در حال انجام» (status = "in_progress")
// دارد؛ این قید با ایندکس یکتای جزئی در سطح SQLite تضمین می‌شود (پس از db push
// از اسکریپت scripts/create-session-indexes.sql اعمال می‌شود) تا کلیک دوباره
// یا ارسال هم‌زمان درخواست، جلسه تکراری نسازد.
//
// ارجاع به برنامه اختیاری است (تمرین آزاد بدون برنامه) و با حذف برنامه با
// onDelete: SetNull حفظ می‌شود تا تاریخچه کاربر با حذف برنامه خراب نشود.
// همه اطلاعات نمایشی حرکت در WorkoutSessionExercise snapshot شده است.

model WorkoutSession {
  id          String   @id @default(cuid())
  userId      String
  // ارجاع اختیاری به برنامه و روز برنامه — حذف برنامه تاریخچه را حذف نمی‌کند
  planId      String?
  planDayId   String?
  title       String
  // وضعیت: in_progress | completed | abandoned — رهاشده با تکمیل‌شده یکی نیست
  status      String   @default("in_progress")
  startedAt   DateTime @default(now()) // زمان واقعی شروع — هنگام ساخت رکورد
  endedAt     DateTime? // زمان ثبت پایان — فقط پس از اقدام صریح کاربر
  notes       String? // یادداشت اختیاری کاربر در پایان جلسه
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        user         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        WorkoutPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  exercises   WorkoutSessionExercise[]

  @@index([userId, status])
  @@index([userId, startedAt])
}

// حرکت ثبت‌شده در جلسه — snapshot حداقلی از بانک/برنامه؛ تاریخچه حتی پس از
// تغییر آینده بانک حرکات یا حذف برنامه از همین snapshot بازسازی می‌شود.
model WorkoutSessionExercise {
  id         String @id @default(cuid())
  sessionId  String
  order      Int // ترتیب اجرا در جلسه
  exerciseId String // شناسه پایدار بانک حرکات (مرجع زنده برای جزئیات کامل)
  // snapshot حداقلی نمایش — مقاوم به تغییر بانک
  faName     String
  enName     String
  category   String
  coach3dId  String? // snapshot — null یعنی واقعاً بدون انیمیشن سه‌بعدی
  primaryMusclesJson String @default("[]") // آرایه شناسه عضلات اصلی (snapshot)
  note       String? // یادداشت اجرا از برنامه (در صورت وجود)
  // تجویز برنامه — برای تمرین آزاد null است (هیچ مقدار ساختگی جایگزین نمی‌شود)
  targetSets     Int?
  targetRepsMin  Int?
  targetRepsMax  Int?
  restSeconds    Int?
  // وضعیت اجرا: pending | done | skipped — ردکردن حرکت صادقانه ثبت می‌شود
  status     String @default("pending")
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sets       WorkoutSetLog[]

  @@index([sessionId, order])
}

// یک ست ثبت‌شده — وجود رکورد به معنی انجام‌شدن واقعی آن ست است؛ ست‌های
// انجام‌نشده هیچ رکوردی ندارند (هیچ مقدار هدفی جای واقعی را پر نمی‌کند).
// برای حرکات وزن بدن weightKg به‌صورت null ذخیره می‌شود (بدون بار خارجی) و
// وزنه صفر هم مجاز است؛ هرگز وزن بدن با وزنه تمرینی جمع نمی‌شود.
model WorkoutSetLog {
  id                String  @id @default(cuid())
  sessionExerciseId String
  setNumber         Int // شماره ست — از ۱؛ انتخاب نهایی با کاربر است
  reps              Int // تعداد تکرار واقعی انجام‌شده
  weightKg          Float? // بار خارجی به کیلوگرم — null یعنی بدون بار خارجی
  note              String? // یادداشت اختیاری ست
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  exercise WorkoutSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionExerciseId, setNumber])
  @@index([sessionExerciseId, setNumber])
}

// ----------------------------------------
// مکالمه دستیار هوشمند — شخصی و متعلق به یک کاربر
// ----------------------------------------
// هر مکالمه فقط برای مالک خودش قابل مشاهده است؛ «نبودن» و «مالک دیگر» در
// لایه API هر دو 404 پاسخ می‌دهند تا هیچ اطلاعاتی افشا نشود. عنوان مکالمه
// از نخستین پیام واقعی کاربر ساخته می‌شود (بدون تولید ساختگی).
// حذف مکالمه با حذف آبشاری همه پیام‌های آن همراه است.

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AssistantMessage[]

  @@index([userId, updatedAt])
}

// پیام داخل مکالمه — نقش فرستنده (user | assistant)، متن واقعی و زمان ثبت.
// lang زبان همان پیام است (fa | en) برای جهت‌دهی صحیح نمایش؛ null یعنی
// نامشخص. متن مدل هرگز جایگزین پیام کاربر نمی‌شود و شکست ارائه‌دهنده پیام
// کاربر را از بین نمی‌برد (پیام user پیش از فراخوانی مدل ذخیره می‌شود).

model AssistantMessage {
  id             String   @id @default(cuid())
  conversationId String
  // مالک پیام (denormalized از مکالمه) — برای کنترل مالکیت و شمارش محدودسازی
  // نرخ درخواست بدون join؛ هم‌اره با مالک مکالمه نوشته می‌شود و رکورد یتیم
  // نمی‌ماند (حذف آبشاری از مسیر مکالمه/کاربر).
  userId         String
  role           String // user | assistant
  content        String
  lang           String? // fa | en — زبان همان پیام
  createdAt      DateTime @default(now())
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, role, createdAt])
}

// ----------------------------------------
// ثبت مصرف واقعی غذا — آنچه کاربر واقعاً خورده، نه برنامه
// ----------------------------------------
// هر ثبت فقط با اقدام صریح کاربر ساخته می‌شود؛ بازدید از صفحه هرگز ثبت
// نمی‌سازد. ثبت از برنامه مستقل است: حذف یا تغییر برنامه، تاریخچه مصرف را
// حذف یا بازنویسی نمی‌کند (ارجاع‌های اختیاری با onDelete: SetNull فقط
// خودشان null می‌شوند و همه اطلاعات نمایشی از snapshot خود رکورد بازسازی
// می‌شود — مقاوم به تغییر بانک غذا و برنامه).
//
// مقادیر انرژی و درشت‌مغذی همیشه سمت سرور و بر پایه داده معتبر بانک یا
// snapshot معتبر قلم برنامه محاسبه می‌شوند؛ هیچ مقدار تغذیه‌ای از مرورگر
// پذیرفته نمی‌شود.
//
// روز محلی (localDay) با همان قرارداد آمار تمرین است: زمان رسمی ایران
// (UTC+3:30 ثابت، بدون ساعت تابستانی) — مرز روز با تغییر منطقه زمانی
// مرورگر جابه‌جا نمی‌شود.
//
// جلوگیری از ثبت تکراری در retry/دوبار کلیک: clientRequestId اختیاری و
// یکتا به‌ازای هر کاربر؛ ارسال مجدد همان درخواست، همان ثبت را برمی‌گرداند
// نه رکورد جدید (SQLite: NULLها در ایندکس یکتا متمایزند — ثبت‌های بدون
// کلید محدودیتی ندارند).

model FoodLogEntry {
  id          String   @id @default(cuid())
  userId      String
  // زمان واقعی مصرف — لحظه UTC؛ نمایش محلی از همین مقدار
  consumedAt  DateTime
  // روز محلی YYYY-MM-DD با زمان رسمی ایران — کلید تجمیع روزانه
  localDay    String
  // نوع وعده — همان enum وعده‌های برنامه غذایی برای سازگاری کامل
  mealType    String   // breakfast | snack_am | lunch | snack_pm | dinner | snack_ev
  // منبع ثبت: بانک غذا یا قلم برنامه — هر دو foodId پایدار دارند
  source      String   // bank | plan_item
  foodId      String   // شناسه پایدار بانک مواد
  // snapshot نمایشی و تغذیه‌ای — تاریخچه مستقل از تغییر آینده بانک
  faName      String
  enName      String
  group       String
  // مقدار ثبت‌شده در واحد انتخابی کاربر + ضریب تبدیل سهم (اگر سهم)
  unit        String   // g | serving
  amount      Float
  servingGramsUsed Float? // snapshot ضریب تبدیل برای unit=serving
  // مقدار نهایی گرم — پس از تبدیل واحد سمت سرور
  grams       Float
  // مقادیر تخمینی همان مقدار — محاسبه سمت سرور (kcal صحیح، مکرو یک اعشار)
  kcal        Int
  protein     Float
  carb        Float
  fat         Float
  // ارجاع اختیاری به برنامه — حذف برنامه تاریخچه را دستکاری نمی‌کند
  planId      String?
  planMealId  String?
  planItemId  String?
  // مقدار پیشنهادی برنامه هنگام ثبت — فقط برای مقایسه شفاف واقعی/پیشنهادی
  planItemGrams Int?
  // کلید ایدمپوتنسی سمت کلاینت — یکتا به‌ازای هر کاربر (null مجاز)
  clientRequestId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        user              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        NutritionPlan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  planMeal    NutritionMeal?    @relation(fields: [planMealId], references: [id], onDelete: SetNull)
  planItem    NutritionMealItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  @@unique([userId, clientRequestId])
  @@index([userId, localDay])
  @@index([userId, consumedAt])
}

// AI Fitness Coach — اسکیمای پایگاه داده (Prisma + SQLite)
//
// ساختار جدول‌های احراز هویت (user / account / session / verification) مطابق
// قرارداد کتابخانه better-auth است؛ hash رمز عبور در جدول account (providerId = "credential")
// نگهداری می‌شود و هیچ‌گاه متن ساده نیست (bcrypt با cost ۱۲).
//
// جدول FitnessProfile با رابطه یک‌به‌یک و حذف آبشاری به user متصل است.
//
// نکته SQLite: Prisma روی SQLite «لیست اسکالر» ندارد؛ فهرست‌ها (تجهیزات،
// محدودیت‌ها، آلرژی‌ها) به‌صورت رشته JSON ذخیره می‌شوند و در لایه سرویس
// تبدیل (marshal/unmarshal) می‌شوند.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------
// جدول‌های احراز هویت — قرارداد better-auth
// ----------------------------------------

model user {
  id                          String                   @id
  name                        String
  email                       String                   @unique
  emailVerified               Boolean                  @default(false)
  image                       String?
  // نقش کاربر — مرجع تصمیم همیشه سرور/دیتابیس است؛ هرگز از کلاینت پذیرفته نمیشود
  // STUDENT (پیشفرض امن) | COACH | ADMIN
  role                        String                   @default("STUDENT")
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  sessions                    session[]
  accounts                    account[]
  fitnessProfile              FitnessProfile?
  weightEntries               weightEntry[]
  workoutPlans                WorkoutPlan[]
  nutritionPlans              NutritionPlan[]
  workoutSessions             WorkoutSession[]
  assistantConversations      AssistantConversation[]
  foodLogEntries              FoodLogEntry[]
  // مربی‌گری — یکپروگرام درخواست + یکپروفایل منتشرشده
  coachApplications           CoachApplication[]
  coachProfile                CoachProfile?
  // اشتراک دانشجو — یک به یک؛ سطح و انقضا فقط سمت سرور مدیریت میشود
  subscription                StudentSubscription?
  // ارتباط دانشجو-مربی — دو سر هر ارتباط
  studentConnections          CoachStudentConnection[] @relation("StudentConnection")
  coachConnections            CoachStudentConnection[] @relation("CoachConnection")
  // برنامه‌های اختصاصی مرحله ۱۶ — ساخت مربی، دریافت دانشجو
  coachWorkoutPlansAuthored   CoachWorkoutPlan[]       @relation("CoachWorkoutPlans")
  coachWorkoutPlansReceived   CoachWorkoutPlan[]       @relation("CoachWorkoutPlanStudents")
  coachNutritionPlansAuthored CoachNutritionPlan[]     @relation("CoachNutritionPlans")
  coachNutritionPlansReceived CoachNutritionPlan[]     @relation("CoachNutritionPlanStudents")
  coachPlanDeliveriesSent     CoachPlanDelivery[]      @relation("CoachPlanDeliveriesSent")
  coachPlanDeliveriesReceived CoachPlanDelivery[]      @relation("CoachPlanDeliveriesReceived")
  // پیام‌رسانی خصوصی مرحله ۱۷ — دو سر هر مکالمه + پیام‌های ارسالی
  studentConversations        CoachConversation[]      @relation("ConversationStudent")
  coachConversations          CoachConversation[]      @relation("ConversationCoach")
  coachMessages               CoachMessage[]           @relation("CoachMessageSender")
  // مرحله ۱۹.۵ — درخواست ارتقا، تیکت‌های پشتیبانی و اقدامات ادمین
  premiumUpgradeRequest       PremiumUpgradeRequest?
  supportTickets              SupportTicket[]
  adminActionLogs             AdminActionLog[]
  // مرحله ۱۹.۶ — اطلاعات بانکی خصوصی (JSON اعتبارسنجی‌شده سمت سرور؛ هرگز در API عمومی/مربی/ادمین افشا نمیشود)
  bankingInfoJson             String?
  // مرحله ۱۹.۶ — مرکز اعلان‌ها، مسدودسازی پیام‌رسان، تعرفه/پرداخت و بانک حرکات شخصی
  notifications               Notification[]
  chatBlocksSet               ChatBlock[]            @relation("ChatBlocksSet")
  chatBlocksReceived          ChatBlock[]            @relation("ChatBlocksReceived")
  coachTariff                 CoachTariff?
  paymentsRequested          PaymentRequest[]       @relation("PaymentCoach")
  paymentsReceived           PaymentRequest[]       @relation("PaymentStudent")
  coachStudentNotes          CoachStudentNote[]     @relation("CoachNotes")
  studentNotesAboutMe        CoachStudentNote[]     @relation("StudentNotes")
  coachExercises             CoachExercise[]
  coachExerciseFolders       CoachExerciseFolder[]  @relation("CoachExerciseFolders")
  // مرحله ۲۰ — گفتگوی آزاد بین هر دو کاربر (جفت مرتب‌شده برای یکتایی)
  dmThreadsInitiated         DirectThread[]         @relation("DirectThreadA")
  dmThreadsReceived          DirectThread[]         @relation("DirectThreadB")
  directMessagesSent         DirectMessage[]        @relation("DirectMessageSender")
  // مرحله ۲۰/P3 — رکوردهای بانک منتشرشده از مشارکت مربی (FK واقعی با SetNull؛
  // حذف حساب مربی رکورد منتشرشده را نگه میدارد و مالک ته میشود — تصمیم Q9)
  publishedCoachExercises    Exercise[]             @relation("ExerciseOwner")
}

model account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  id             String   @id
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  impersonatedBy String?
  user           user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ----------------------------------------
// پروفایل تناسب اندام — یک‌به‌یک با user
// ----------------------------------------

model FitnessProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  // هویت نمایشی
  displayName         String
  // مشخصات بدنی
  age                 Int?
  gender              String? // male | female | undisclosed (اختیاری — برای فرمول‌های آینده)
  heightCm            Float?
  weightKg            Float?
  bodyFat             Float? // اختیاری — در صورت اطلاع کاربر
  // هدف و سطح
  goal                String? // fat_loss | muscle_gain | strength | maintain | fitness
  experience          String? // beginner | intermediate | advanced
  trainingDaysPerWeek Int? // ۱ تا ۷
  sessionMinutes      Int? // مدت هر جلسه (اختیاری)
  // تجهیزات و محدودیت‌ها (محرمانه — فقط برای همین کاربر)
  equipmentJson       String   @default("[]") // آرایه JSON از کدهای تجهیزات
  limitationsJson     String   @default("[]") // آرایه JSON از کدهای محدودیت
  limitationNotes     String? // توضیح آزاد کاربر (اختیاری)
  // ترجیحات غذایی (برای مرحله تغذیه)
  diet                String?
  allergiesJson       String   @default("[]") // آرایه JSON از کدهای آلرژی
  // واحد اندازه‌گیری
  units               String   @default("metric") // metric | imperial
  // زمان‌ها
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------
// اندازه‌گیری وزن — تاریخچه شخصی هر کاربر
// ----------------------------------------
// روند تغییر وزن فقط با اندازه‌گیری‌های تاریخ‌دار معنا دارد؛ وزن لحظه‌ای
// پروفایل جدا نگه داشته می‌شود و با این تاریخچه اشتباه گرفته نمی‌شود.

model weightEntry {
  id         String   @id @default(cuid())
  userId     String
  weightKg   Float
  recordedAt DateTime // تاریخ ثبت اندازه‌گیری (نیمه‌روزها به ابتدای روز)
  createdAt  DateTime @default(now())
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

// ----------------------------------------
// برنامه تمرینی — شخصی و متعلق به یک کاربر
// ----------------------------------------
// هر کاربر می‌تواند چند برنامه داشته باشد؛ در هر لحظه حداکثر یک برنامه
// «فعال» (status = "active") و بقیه «بایگانی» (status = "archived").
// تنظیمات برنامه (ورودی موتور برنامه‌سازی) برای شفافیت و بازتولید آینده
// در خود برنامه ذخیره می‌شود.
//
// نکته SQLite: فهرست‌ها به‌صورت رشته JSON ذخیره می‌شوند (همان الگوی
// FitnessProfile) و در لایه سرویس marshal/unmarshal می‌شوند.

model WorkoutPlan {
  id                      String           @id @default(cuid())
  userId                  String
  title                   String
  // ورودی‌های موتور برنامه‌سازی (snapshot تنظیمات کاربر)
  goal                    String // fat_loss | muscle_gain | strength | maintain | fitness
  experience              String // beginner | intermediate | advanced
  daysPerWeek             Int // ۲ تا ۶
  sessionMinutes          Int // ۳۰ | ۴۵ | ۶۰ | ۹۰
  equipmentJson           String           @default("[]") // آرایه شناسه تجهیزات (واژگان بانک حرکات)
  focus                   String           @default("all") // all | upper | lower | شناسه دسته
  preferredDaysJson       String           @default("[]") // آرایه ۰ تا ۶ (شنبه=۰) — اختیاری
  excludedCategoriesJson  String           @default("[]") // دسته‌های حذف‌شده
  excludedExerciseIdsJson String           @default("[]") // حرکات حذف‌شده
  limitationNotes         String? // توضیح احتیاطی کاربر (snapshot اختیاری)
  notesJson               String           @default("[]") // راهنماهای عمومی تولیدشده موتور (گرم‌کردن، پیشرفت، …)
  // وضعیت و ردیابی
  status                  String           @default("active") // active | archived
  libraryVersion          String // نسخه بانک حرکات هنگام تولید
  // زبان تولید محتوای برنامه (title/notes) — رکوردهای قدیمی «fa»؛ هرگز بازنویسی نمی‌شوند
  contentLocale           String           @default("fa")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  user                    user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  days                    WorkoutPlanDay[]
  sessions                WorkoutSession[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// روز یا جلسه تمرینی برنامه — ترتیب در هفته
model WorkoutPlanDay {
  id         String                @id @default(cuid())
  planId     String
  order      Int // ترتیب جلسه در هفته (۱ تا N)
  weekday    Int? // ۰ تا ۶ (شنبه=۰) — فقط اگر کاربر روز ترجیحی داشته باشد
  title      String // عنوان جلسه مثل «پوش — سینه و پشت بازو»
  focusLabel String // برچسب تمرکز مثل «بالاتنه»
  estMinutes Int // زمان تقریبی جلسه شامل گرم‌کردن
  plan       WorkoutPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises  WorkoutPlanExercise[]

  @@index([planId, order])
}

// حرکت داخل جلسه — شناسه پایدار بانک + snapshot حداقلی برای مقاومت در برابر
// تغییر آینده بانک؛ جزئیات کامل اجرا در نمایش از بانک زنده خوانده می‌شود.
model WorkoutPlanExercise {
  id               String         @id @default(cuid())
  dayId            String
  order            Int // ترتیب اجرا در جلسه
  exerciseId       String // شناسه پایدار در بانک حرکات
  faName           String // snapshot نام فارسی
  enName           String // snapshot نام انگلیسی
  category         String // snapshot دسته
  coach3dId        String? // snapshot — null یعنی واقعاً بدون انیمیشن (صادقانه)
  sets             Int
  repsMin          Int
  repsMax          Int
  restSeconds      Int
  estimatedMinutes Int
  note             String? // یادداشت کوتاه اجرا (snapshot معرفی حرکت)
  day              WorkoutPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId, order])
}

// ----------------------------------------
// برنامه غذایی — شخصی و متعلق به یک کاربر
// ----------------------------------------
// همان الگوی WorkoutPlan: چند برنامه برای هر کاربر، حداکثر یک برنامه فعال.
// تنظیمات (ورودی موتور) و snapshot کامل محاسبات برای شفافیت و بازتولید
// ذخیره می‌شود؛ مواد داخل وعده‌ها snapshot حداقلی دارند تا تغییر آینده
// بانک مواد غذایی برنامه‌های ذخیره‌شده را ناخواسته تغییر ندهد.
//
// نکته SQLite: فهرست‌ها به‌صورت رشته JSON ذخیره می‌شوند و در لایه سرویس
// marshal/unmarshal می‌شوند (الگوی FitnessProfile و WorkoutPlan).

model NutritionPlan {
  id                  String             @id @default(cuid())
  userId              String
  title               String
  // ورودی‌های موتور (snapshot تنظیمات کاربر)
  goal                String // weight_loss | muscle_gain | maintain
  activityLevel       String // sedentary | light | moderate | active | very_active
  dietPattern         String             @default("none") // none | vegetarian | vegan
  mealsPerDay         Int // ۳ تا ۶
  planLength          Int // ۱ یا ۷ (روز)
  allergensJson       String             @default("[]") // آلرژن‌های حذف‌شده
  dislikedFoodIdsJson String             @default("[]") // مواد نامطلوب
  budget              String             @default("any") // any | low
  prep                String             @default("any") // any | simple
  estimateJson        String             @default("null") // اطلاعات برآورد استفاده‌شده (سن/قد/وزن/جنسیت)
  // snapshot محاسبات انرژی و درشت‌مغذی — BMR/TDEE/هدف/مکروها/هشدارها
  calcJson            String
  // یادداشت‌های عمومی تولیدشده موتور (محدودیت‌ها، راهنماهای صادقانه)
  notesJson           String             @default("[]")
  // وضعیت و ردیابی نسخه‌ها
  caution             Boolean            @default(false) // حالت احتیاط (زیر ۱۸ یا بارداری) — بدون هدف کالری کاهشی
  status              String             @default("active") // active | archived
  engineVersion       String // نسخه موتور هنگام تولید
  // زبان تولید محتوای برنامه (title/notes/هشدارها) — رکوردهای قدیمی «fa»؛ هرگز بازنویسی نمی‌شوند
  contentLocale       String             @default("fa")
  foodsVersion        String // نسخه بانک مواد هنگام تولید
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  days                NutritionPlanDay[]
  foodLogEntries      FoodLogEntry[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// یک روز برنامه غذایی — ترتیب در برنامه (۱ تا ۷)
model NutritionPlanDay {
  id     String          @id @default(cuid())
  planId String
  order  Int // ترتیب روز
  plan   NutritionPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals  NutritionMeal[]

  @@index([planId, order])
}

// وعده داخل روز — مجموع‌ها از اجزای واقعی محاسبه و هم‌زمان ذخیره می‌شوند
model NutritionMeal {
  id             String              @id @default(cuid())
  dayId          String
  order          Int // ترتیب وعده در روز
  type           String // breakfast | snack_am | lunch | snack_pm | dinner | snack_ev
  title          String
  kcal           Int
  protein        Float
  carb           Float
  fat            Float
  day            NutritionPlanDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  items          NutritionMealItem[]
  foodLogEntries FoodLogEntry[]

  @@index([dayId, order])
}

// ماده غذایی داخل وعده — شناسه پایدار بانک + مقدار گرم + snapshot ارزش
// تخمینی همان مقدار؛ بازسازی نمایش کاملاً از همین snapshot ممکن است.
model NutritionMealItem {
  id             String         @id @default(cuid())
  mealId         String
  order          Int // ترتیب نمایش
  foodId         String // شناسه پایدار در بانک مواد
  faName         String
  enName         String
  group          String
  grams          Int
  kcal           Int
  protein        Float
  carb           Float
  fat            Float
  servingHint    String // برچسب سهم متداول بانک هنگام تولید
  meal           NutritionMeal  @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodLogEntries FoodLogEntry[]

  @@index([mealId, order])
}

// ----------------------------------------
// جلسه تمرینی واقعی — ثبت انجام‌شده‌ها، نه برنامه
// ----------------------------------------
// جلسه فقط با اقدام صریح کاربر («شروع تمرین») ساخته می‌شود و با «پایان تمرین»
// یا «رهاکردن» بسته می‌شود. بازدید از صفحه هرگز جلسه نمی‌سازد.
//
// هر کاربر در هر لحظه حداکثر یک جلسه «در حال انجام» (status = "in_progress")
// دارد؛ این قید با ایندکس یکتای جزئی در سطح SQLite تضمین می‌شود (پس از db push
// از اسکریپت scripts/create-session-indexes.sql اعمال می‌شود) تا کلیک دوباره
// یا ارسال هم‌زمان درخواست، جلسه تکراری نسازد.
//
// ارجاع به برنامه اختیاری است (تمرین آزاد بدون برنامه) و با حذف برنامه با
// onDelete: SetNull حفظ می‌شود تا تاریخچه کاربر با حذف برنامه خراب نشود.
// همه اطلاعات نمایشی حرکت در WorkoutSessionExercise snapshot شده است.

model WorkoutSession {
  id                    String                   @id @default(cuid())
  userId                String
  // ارجاع اختیاری به برنامه و روز برنامه — حذف برنامه تاریخچه را حذف نمی‌کند
  planId                String?
  planDayId             String?
  // ارجاع اختیاری به نسخه ارسال‌شده برنامه اختصاصی مربی (مرحله ۱۶) —
  // بدون FK؛ سرویس جلسه مالکیت و وجود آن را سمت سرور اعتبارسنجی می‌کند و
  // delivery ها هرگز حذف نمی‌شوند (تاریخچه همیشه قابل بازیابی می‌ماند)
  coachDeliveryId       String?
  coachDeliveryDayOrder Int?
  title                 String
  // وضعیت: in_progress | completed | abandoned — رهاشده با تکمیل‌شده یکی نیست
  status                String                   @default("in_progress")
  startedAt             DateTime                 @default(now()) // زمان واقعی شروع — هنگام ساخت رکورد
  endedAt               DateTime? // زمان ثبت پایان — فقط پس از اقدام صریح کاربر
  notes                 String? // یادداشت اختیاری کاربر در پایان جلسه
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  user                  user                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  WorkoutPlan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  exercises             WorkoutSessionExercise[]

  @@index([userId, status])
  @@index([userId, startedAt])
}

// حرکت ثبت‌شده در جلسه — snapshot حداقلی از بانک/برنامه؛ تاریخچه حتی پس از
// تغییر آینده بانک حرکات یا حذف برنامه از همین snapshot بازسازی می‌شود.
model WorkoutSessionExercise {
  id                 String          @id @default(cuid())
  sessionId          String
  order              Int // ترتیب اجرا در جلسه
  exerciseId         String // شناسه پایدار بانک حرکات (مرجع زنده برای جزئیات کامل)
  // snapshot حداقلی نمایش — مقاوم به تغییر بانک
  faName             String
  enName             String
  category           String
  coach3dId          String? // snapshot — null یعنی واقعاً بدون انیمیشن سه‌بعدی
  primaryMusclesJson String          @default("[]") // آرایه شناسه عضلات اصلی (snapshot)
  note               String? // یادداشت اجرا از برنامه (در صورت وجود)
  // تجویز برنامه — برای تمرین آزاد null است (هیچ مقدار ساختگی جایگزین نمی‌شود)
  targetSets         Int?
  targetRepsMin      Int?
  targetRepsMax      Int?
  restSeconds        Int?
  // وزن پیشنهادی مربی در برنامه اختصاصی (مرحله ۱۶) — فقط نمایشی؛ هرگز
  // جای مقدار واقعی ثبت‌شده کاربر را پر نمی‌کند و در آمار دخالت ندارد
  targetWeightKg     Float?
  // وضعیت اجرا: pending | done | skipped — ردکردن حرکت صادقانه ثبت می‌شود
  status             String          @default("pending")
  session            WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sets               WorkoutSetLog[]

  @@index([sessionId, order])
}

// یک ست ثبت‌شده — وجود رکورد به معنی انجام‌شدن واقعی آن ست است؛ ست‌های
// انجام‌نشده هیچ رکوردی ندارند (هیچ مقدار هدفی جای واقعی را پر نمی‌کند).
// برای حرکات وزن بدن weightKg به‌صورت null ذخیره می‌شود (بدون بار خارجی) و
// وزنه صفر هم مجاز است؛ هرگز وزن بدن با وزنه تمرینی جمع نمی‌شود.
model WorkoutSetLog {
  id                String                 @id @default(cuid())
  sessionExerciseId String
  setNumber         Int // شماره ست — از ۱؛ انتخاب نهایی با کاربر است
  reps              Int // تعداد تکرار واقعی انجام‌شده
  weightKg          Float? // بار خارجی به کیلوگرم — null یعنی بدون بار خارجی
  note              String? // یادداشت اختیاری ست
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  exercise          WorkoutSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionExerciseId, setNumber])
  @@index([sessionExerciseId, setNumber])
}

// ----------------------------------------
// مکالمه دستیار هوشمند — شخصی و متعلق به یک کاربر
// ----------------------------------------
// هر مکالمه فقط برای مالک خودش قابل مشاهده است؛ «نبودن» و «مالک دیگر» در
// لایه API هر دو 404 پاسخ می‌دهند تا هیچ اطلاعاتی افشا نشود. عنوان مکالمه
// از نخستین پیام واقعی کاربر ساخته می‌شود (بدون تولید ساختگی).
// حذف مکالمه با حذف آبشاری همه پیام‌های آن همراه است.

model AssistantConversation {
  id        String             @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AssistantMessage[]

  @@index([userId, updatedAt])
}

// پیام داخل مکالمه — نقش فرستنده (user | assistant)، متن واقعی و زمان ثبت.
// lang زبان همان پیام است (fa | en) برای جهت‌دهی صحیح نمایش؛ null یعنی
// نامشخص. متن مدل هرگز جایگزین پیام کاربر نمی‌شود و شکست ارائه‌دهنده پیام
// کاربر را از بین نمی‌برد (پیام user پیش از فراخوانی مدل ذخیره می‌شود).

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  // مالک پیام (denormalized از مکالمه) — برای کنترل مالکیت و شمارش محدودسازی
  // نرخ درخواست بدون join؛ هم‌اره با مالک مکالمه نوشته می‌شود و رکورد یتیم
  // نمی‌ماند (حذف آبشاری از مسیر مکالمه/کاربر).
  userId         String
  role           String // user | assistant
  content        String
  lang           String? // fa | en — زبان همان پیام
  createdAt      DateTime              @default(now())
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, role, createdAt])
}

// ----------------------------------------
// ثبت مصرف واقعی غذا — آنچه کاربر واقعاً خورده، نه برنامه
// ----------------------------------------
// هر ثبت فقط با اقدام صریح کاربر ساخته می‌شود؛ بازدید از صفحه هرگز ثبت
// نمی‌سازد. ثبت از برنامه مستقل است: حذف یا تغییر برنامه، تاریخچه مصرف را
// حذف یا بازنویسی نمی‌کند (ارجاع‌های اختیاری با onDelete: SetNull فقط
// خودشان null می‌شوند و همه اطلاعات نمایشی از snapshot خود رکورد بازسازی
// می‌شود — مقاوم به تغییر بانک غذا و برنامه).
//
// مقادیر انرژی و درشت‌مغذی همیشه سمت سرور و بر پایه داده معتبر بانک یا
// snapshot معتبر قلم برنامه محاسبه می‌شوند؛ هیچ مقدار تغذیه‌ای از مرورگر
// پذیرفته نمی‌شود.
//
// روز محلی (localDay) با همان قرارداد آمار تمرین است: زمان رسمی ایران
// (UTC+3:30 ثابت، بدون ساعت تابستانی) — مرز روز با تغییر منطقه زمانی
// مرورگر جابه‌جا نمی‌شود.
//
// جلوگیری از ثبت تکراری در retry/دوبار کلیک: clientRequestId اختیاری و
// یکتا به‌ازای هر کاربر؛ ارسال مجدد همان درخواست، همان ثبت را برمی‌گرداند
// نه رکورد جدید (SQLite: NULLها در ایندکس یکتا متمایزند — ثبت‌های بدون
// کلید محدودیتی ندارند).

model FoodLogEntry {
  id               String             @id @default(cuid())
  userId           String
  // زمان واقعی مصرف — لحظه UTC؛ نمایش محلی از همین مقدار
  consumedAt       DateTime
  // روز محلی YYYY-MM-DD با زمان رسمی ایران — کلید تجمیع روزانه
  localDay         String
  // نوع وعده — همان enum وعده‌های برنامه غذایی برای سازگاری کامل
  mealType         String // breakfast | snack_am | lunch | snack_pm | dinner | snack_ev
  // منبع ثبت: بانک غذا یا قلم برنامه — هر دو foodId پایدار دارند
  source           String // bank | plan_item
  foodId           String // شناسه پایدار بانک مواد
  // snapshot نمایشی و تغذیه‌ای — تاریخچه مستقل از تغییر آینده بانک
  faName           String
  enName           String
  group            String
  // مقدار ثبت‌شده در واحد انتخابی کاربر + ضریب تبدیل سهم (اگر سهم)
  unit             String // g | serving
  amount           Float
  servingGramsUsed Float? // snapshot ضریب تبدیل برای unit=serving
  // مقدار نهایی گرم — پس از تبدیل واحد سمت سرور
  grams            Float
  // مقادیر تخمینی همان مقدار — محاسبه سمت سرور (kcal صحیح، مکرو یک اعشار)
  kcal             Int
  protein          Float
  carb             Float
  fat              Float
  // ارجاع اختیاری به برنامه — حذف برنامه تاریخچه را دستکاری نمی‌کند
  planId           String?
  planMealId       String?
  planItemId       String?
  // مقدار پیشنهادی برنامه هنگام ثبت — فقط برای مقایسه شفاف واقعی/پیشنهادی
  planItemGrams    Int?
  // کلید ایدمپوتنسی سمت کلاینت — یکتا به‌ازای هر کاربر (null مجاز)
  clientRequestId  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             NutritionPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  planMeal         NutritionMeal?     @relation(fields: [planMealId], references: [id], onDelete: SetNull)
  planItem         NutritionMealItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  @@unique([userId, clientRequestId])
  @@index([userId, localDay])
  @@index([userId, consumedAt])
}

// ----------------------------------------
// درخواست مربی‌گری — ورودی کاربر به مسیر مربی شدن
// ----------------------------------------
// هر کاربر فقط یک رکورد درخواست دارد؛ وضعیت آن فقط سمت سرور (ابزار مدیریتی
// امن، نه API عمومی) تغییر میکند. تأیید درخواست، نقش COACH و پروفایل اولیه
// مربی را میسازد. هیچ سیستم تأیید موازیِ دیگری وجود ندارد.

model CoachApplication {
  id                 String    @id @default(cuid())
  userId             String    @unique
  // pending | approved | rejected
  status             String    @default("pending")
  // معرفی خودمتقاضی — اختیاری، سقف طول در لایه اعتبارسنجی
  message            String?
  experienceYears    Int?
  certificationsJson String    @default("[]") // آرایه رشته — مدارک اعلامی متقاضی
  decidedAt          DateTime?
  decidedBy          String? // شناسه ادمین/ابزار مدیریتی — فقط ردیابی داخلی
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments        CoachApplicationAttachment[]

  @@index([status, createdAt])
}

// ----------------------------------------
// پیوست درخواست مربی‌گری — سند/تصویر با عنوان (مرحله ۱۹.۵ب)
// ----------------------------------------
// مدارک متقاضی (مدرک مربی‌گری، سابقه کار و…) که با عنوان دلخواه بارگذاری
// میشود. فایل روی دیسک خارج از public نگهداری میشود و فقط از مسیر API
// مالکیت‌محور خوانده میشود: مالک درخواست یا ادمین. محتوای فایل هرگز از
// کلاینت قابل تغییر نیست (دربردارنده مالکیت است) و پس از تصمیم ادمین برای
// تاریخچه حفظ میشود. کل اندازه هر فایل و نوع MIME در لایه سرور و
// whitelist سخت‌گیرانه کنترل میشود؛ نام فایل روی دیسک هرگز از ورودی
// کاربر گرفته نمیشود (جلوگیری از path traversal).

model CoachApplicationAttachment {
  id            String    @id @default(cuid())
  applicationId String
  // عنوان دلخواه سند — سقف طول در لایه اعتبارسنجی
  title         String
  // نام اصلی فایل فقط برای نمایش به ادمین/مالک — هرگز برای مسیر دیسک استفاده نمیشود
  fileName      String
  mimeType      String
  sizeBytes     Int
  // مسیر نسبی ذخیره روی دیسک (داخل data/uploads/coach-applications)
  storagePath   String
  createdAt     DateTime  @default(now())
  application   CoachApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

// ----------------------------------------
// پروفایل حرفه‌ای مربی — یک به یک با user
// ----------------------------------------
// دو پرچم جدا از هم:
//  - verified: تأیید مدیریت (فقط سمت سرور با ابزار امن) — هرگز از کلاینت نمیآید
//  - published: انتشار عمومی — خود مربی فقط در صورت verified بودن و کامل بودن
//    حداقل اطلاعات، از طریق API مالکیت‌محور تغییرش میدهد
// فهرست عمومی مربیان فقط رکوردهای verified+published را نشان میدهد.
// از دست رفتن تأیید یا انتشار، ارتباطهای قبلی را نمیشکند (تاریخچه حفظ
// میشود)؛ فقط درخواست جدید مسدود و نمایش در فهرست عمومی متوقف میشود.

model CoachProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  displayName          String
  headline             String? // عنوان حرفه‌ای کوتاه
  bio                  String? // معرفی حرفه‌ای — سقف طول در اعتبارسنجی
  specializationsJson  String   @default("[]") // آرایه کد تخصص
  certificationsJson   String   @default("[]") // آرایه رشته مدارک منتشرشده
  experienceYears      Int?
  // انواع همکاری واقعاً ارائهشده: SEMI_PRIVATE | PRIVATE
  cooperationTypesJson String   @default("[]")
  verified             Boolean  @default(false)
  published            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verified, published])
}

// ----------------------------------------
// اشتراک دانشجو — سطح دسترسی FREE / PREMIUM
// ----------------------------------------
// هر کاربر دقیقاً یک رکورد اشتراک دارد (ساخت تنبل با پیشفرض امن FREE در
// اولین نیاز سمت سرور). در این مرحله هیچ پرداختی وجود ندارد؛ اعطای
// PREMIUM فقط با ابزار مدیریتی سمت سرور (منبع: manual) انجام میشود و
// هیچ مسیر کلاینتی نمیتواند tier را تغییر دهد.
// انقضا: اگر expiresAt در گذشته باشد، سطح مؤثر FREE است (بررسی قطعی و
// تنبل در هر استفاده — بدون اتکا به حافظه فرایند)؛ رکورد دستنخورده
// میماند تا وضعیت شفاف بماند.
// اشتراک هیچ ارتباطی به نقش ندارد: COACH/ADMIN مشمول منطق دانشجو
// نمیشوند و PREMIUM بودن هیچ مجوز مربی‌گری نمیدهد.

model StudentSubscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  tier      String    @default("FREE") // FREE | PREMIUM
  status    String    @default("active") // active | cancelled
  // منبع اعطای سطح — بدون هیچ داده حساس پرداخت
  source    String    @default("system") // system | manual
  note      String? // یادداشت شفاف اعطای دستی (بدون داده حساس)
  startsAt  DateTime  @default(now())
  // انقضا اختیاری — null یعنی بدون پایان مشخص (پیشفرض FREE)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier, status])
}

// ----------------------------------------
// ارتباط دانشجو و مربی — چرخه درخواست تا پایان
// ----------------------------------------
// وضعیت‌ها و انتقالهای مجاز (فقط سمت سرور اعتبارسنجی میشود):
//   PENDING -> ACTIVE    (پذیرش مربی مالک)
//   PENDING -> REJECTED  (رد مربی مالک + دلیل اختیاری)
//   PENDING -> CANCELLED (لغو دانشجو مالک)
//   ACTIVE  -> ENDED     (پایان توسط هر دو طرف با سیاست صریح)
//   REJECTED/CANCELLED/ENDED ترمینالاند — هیچ درخواست کلاینتی آنها را
//   تغییر نمیدهد؛ درخواست جدید باید ساخته شود.
// قید یکتایی «حداکثر یک ارتباط باز (PENDING/ACTIVE) به‌ازای هر جفت
// دانشجو-مربی» با ایندکس partial سطح SQLite اعمال میشود (پس از db push
// با scripts/apply-p15-indexes.mjs — همان الگوی جلسه تمرینی).
// studentId از نشست سرور میآید و coachId فقط بهعنوان شناسه منبع عمومی
// خوانده و سمت سرور بازبینی میشود؛ هیچکدام از کلاینت معتبر نیستند.

model CoachStudentConnection {
  id              String             @id @default(cuid())
  studentId       String
  coachId         String
  status          String             @default("PENDING") // PENDING | ACTIVE | REJECTED | CANCELLED | ENDED
  cooperationType String // SEMI_PRIVATE | PRIVATE — باید از انواع ارائهشده مربی باشد
  message         String? // معرفی و هدف دانشجو — سقف طول در اعتبارسنجی
  rejectionReason String? // دلیل رد مربی — اختیاری با سقف طول
  requestedAt     DateTime           @default(now())
  decidedAt       DateTime? // زمان تصمیم مربی (پذیرش یا رد)
  endedAt         DateTime? // زمان لغو یا پایان ارتباط
  endedBy         String? // «student» | «coach» — کدام طرف ارتباط را پایان داد
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  student         user               @relation("StudentConnection", fields: [studentId], references: [id], onDelete: Cascade)
  coach           user               @relation("CoachConnection", fields: [coachId], references: [id], onDelete: Cascade)
  // مکالمه خصوصی مرحله ۱۷ — حداکثر یک مکالمه به‌ازای هر ارتباط (unique سمت مکالمه)
  conversation    CoachConversation?

  @@index([studentId, status, requestedAt])
  @@index([coachId, status, requestedAt])
}

// ----------------------------------------
// برنامه تمرینی اختصاصی مربی — مرحله ۱۶
// ----------------------------------------
// مالکیت دوگانه روشن: سازنده همیشه coachId (از نشست سرور) و دریافتکننده
// فقط پس از نخستین انتشار و با استخراج studentId از ارتباط ACTIVE سمت
// سرور مشخص میشود — هیچکدام از کلاینت پذیرفته نمیشوند.
//
// چرخه وضعیت: draft -> published (نخستین ارسال) -> archived (بایگانی
// یکطرفه). ویرایش محتوای برنامه پس از انتشار مجاز است، اما هرگز نسخههای
// ارسالشده را تغییر نمیدهد؛ اعمال تغییرات فقط با «ارسال مجدد» و ساخت
// نسخه جدید در CoachPlanDelivery ممکن است.
//
// محتوای روزها/حرکات در contentJson با همان الگوی snapshot پروژه ذخیره
// میشود: نامها، دسته و شناسه سهبعدی هر حرکت هنگام ذخیره از بانک زنده
// سمت سرور خوانده میشوند و داده ارسالی کلاینت برای این فیلدها هرگز
// معتبر نیست. contentHash (sha256 محتوای نرمال) جلوگیری از ارسال مجدد
// بدون تغییر را ممکن میکند.
//
// estimatedMinutes هر روز با همان فرمول موتور برنامهساز محاسبه میشود.

model CoachWorkoutPlan {
  id              String    @id @default(cuid())
  coachId         String
  // پس از نخستین انتشار پر میشود و هرگز تغییر دانشجو نمیکند
  studentId       String?
  connectionId    String?
  title           String
  description     String    @default("")
  // fat_loss | muscle_gain | strength | maintain | fitness — همان واژگان موتور
  goal            String
  // beginner | intermediate | advanced — همان واژگان سطح
  difficulty      String
  // بازه زمانی تقریبی هر جلسه به دقیقه — اعلام مربی (نمایشی)
  durationMinutes Int
  // snapshot کامل روزها و حرکات — ساختار در لایه سرویس اعتبارسنجی میشود
  contentJson     String
  // sha256 محتوای نرمالشده — ارسال مجدد بدون تغییر محتوا را 409 میکند
  contentHash     String    @default("")
  // draft | published | archived
  status          String    @default("draft")
  currentVersion  Int       @default(0)
  firstSentAt     DateTime?
  lastSentAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  coach           user      @relation("CoachWorkoutPlans", fields: [coachId], references: [id], onDelete: Cascade)
  student         user?     @relation("CoachWorkoutPlanStudents", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([coachId, status, updatedAt])
  @@index([studentId, status])
}

// ----------------------------------------
// برنامه غذایی اختصاصی مربی — مرحله ۱۶
// ----------------------------------------
// همان مالکیت و چرخه CoachWorkoutPlan. مقادیر انرژی و درشتمغذی هر قلم،
// وعده و روز همیشه سمت سرور با macrosForGrams بانک غذا محاسبه و در
// contentJson ذخیره میشوند؛ هر عدد تغذیهای ارسالی کلاینت نادیده گرفته
// میشود. واحدهای مجاز فقط گرم و سهم متداول بانک است و تبدیل سهم هم
// سمت سرور انجام میشود.

model CoachNutritionPlan {
  id             String    @id @default(cuid())
  coachId        String
  studentId      String?
  connectionId   String?
  title          String
  description    String    @default("")
  // weight_loss | muscle_gain | maintain — همان واژگان برنامه غذایی
  goal           String
  // بازه زمانی برنامه به روز — ۱ تا ۷ (همان محدوده برنامه غذایی موجود)
  durationDays   Int
  contentJson    String
  contentHash    String    @default("")
  // draft | published | archived
  status         String    @default("draft")
  currentVersion Int       @default(0)
  firstSentAt    DateTime?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  coach          user      @relation("CoachNutritionPlans", fields: [coachId], references: [id], onDelete: Cascade)
  student        user?     @relation("CoachNutritionPlanStudents", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([coachId, status, updatedAt])
  @@index([studentId, status])
}

// ----------------------------------------
// نسخه ارسالشده برنامه اختصاصی — snapshot تغییرناپذیر
// ----------------------------------------
// هر «ارسال» یک ردیف جدید میسازد؛ این رکوردها هرگز ویرایش یا حذف
// نمیشوند تا تاریخچه برنامههای قبلی دانشجو حتی پس از ویرایش پیشنویس
// مربی یا تغییر آینده بانکها کامل بماند (نامها و مقادیر ضروری داخل
// contentJson کپی شدهاند).
//
// قید یکتای (planId, version) با ایندکس یکتای معمولی SQLite اعمال
// میشود و دو ارسال همزمانِ یک برنامه را ناممکن میکند — رقابت با
// P2002 به 409 ترجمه میشود.
//
// planKind مشخص میکند planId به کدام جدول برنامه برمیگردد (workout
// یا nutrition)؛ یکتایی نسخه درون هر نوع برنامه مستقل است.

model CoachPlanDelivery {
  id           String   @id @default(cuid())
  // workout | nutrition
  planKind     String
  planId       String
  version      Int
  coachId      String
  studentId    String
  connectionId String
  title        String
  description  String   @default("")
  goal         String
  // workout: { difficulty, durationMinutes } — nutrition: { durationDays }
  metaJson     String   @default("{}")
  // snapshot کامل و تغییرناپذیر محتوای برنامه در لحظه ارسال
  contentJson  String
  // حذف نرم توسط دانشجو — فقط از فهرست خود دانشجو پنهان میشود؛
  // تاریخچه مربی و سایر دیدگاهها دست‌نخورده میماند (مرحله ۲۰)
  studentDeletedAt DateTime?
  sentAt       DateTime @default(now())
  coach        user     @relation("CoachPlanDeliveriesSent", fields: [coachId], references: [id], onDelete: Cascade)
  student      user     @relation("CoachPlanDeliveriesReceived", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
  @@index([studentId, planKind, sentAt])
  @@index([coachId, sentAt])
}

// ----------------------------------------
// تعرفه مربی — مرحله ۱۹.۶
// ----------------------------------------
// قیمت خدمات خصوصی و نیمهخصوصی به ریال و دلار. ثبتنشده بودن قیمت = null
// (هرگز صفر یا رایگان نمایش داده نمیشود). تعرفه داده عمومی مربی است و در
// فهرست/جزئیات عمومی نمایش داده میشود — اطلاعات بانکی خصوصی هرگز اینجا نیست.
// مبلغ درخواست پرداخت در لحظه ساخت داخل PaymentRequest کپی میشود؛ تغییر
// بعدی تعرفه رکوردهای قبلی را تغییر نمیدهد.

model CoachTariff {
  id                  String   @id @default(cuid())
  coachId             String   @unique
  privatePriceIrr     Int?
  privatePriceUsd     Int?
  semiPrivatePriceIrr Int?
  semiPrivatePriceUsd Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  coach               user     @relation(fields: [coachId], references: [id], onDelete: Cascade)
}

// ----------------------------------------
// درخواست پرداخت — مرحله ۱۹.۶
// ----------------------------------------
// مربی برای دانشجوی متصل درخواست پرداخت با لینک خارجی میسازد. گردش کار:
//   PENDING   (در انتظار تأیید دانشجو — لینک برای دانشجو فعال نیست)
//   CONFIRMED (دانشجو تأیید کرد — لینک فعال؛ وضعیت همچنان «در انتظار پرداخت»
//              تا اتصال درگاه واقعی در مرحله بعد)
//   DECLINED  (دانشجو رد کرد)
//   CANCELLED (لغو مربی)
// باز کردن/کلیک روی لینک به هیچ وجه پرداخت موفق تلقی نمیشود و هیچ مسیری
// وضعیت را PAID نمیکند. مبلغ/واحد در لحظه ساخت ثبت و تغییر تعرفه بعدی
// رکوردهای قبلی را تغییر نمیدهد.

model PaymentRequest {
  id                String    @id @default(cuid())
  coachId           String
  studentId         String
  connectionId      String
  // PRIVATE | SEMI_PRIVATE — باید از انواع ارائهشده مربی باشد
  serviceType       String
  amount            Int
  // IRR | USD
  currency          String
  description       String    @default("")
  // لینک پرداخت خارجی — فقط https اعتبارسنجی میشود
  externalLink      String
  status            String    @default("PENDING")
  studentConfirmedAt DateTime?
  studentDeclinedAt  DateTime?
  studentNote       String?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  coach             user      @relation("PaymentCoach", fields: [coachId], references: [id], onDelete: Cascade)
  student           user      @relation("PaymentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([coachId, createdAt])
  @@index([studentId, createdAt])
  @@index([connectionId])
}

// ----------------------------------------
// مکالمه خصوصی مربی و دانشجو — مرحله ۱۷
// ----------------------------------------
// حداکثر یک مکالمه به‌ازای هر CoachStudentConnection (قید unique روی
// connectionId — ساخت تنبل در نخستین «گشودن گفت‌وگو» یا نخستین پیام،
// همیشه سمت سرور و همیشه پس از بازبینی مالکیت و وضعیت ارتباط).
//
// studentId/coachId کپی شناسه‌های همان ارتباط‌اند (سمت سرویس اعتبارسنجی
// می‌شوند که با رکورد ارتباط برابرند) تا فهرست مکالمه‌ها بدون join زنجیره‌ای
// و با ایندکس مستقیم خوانده شود.
//
// lastSeq شمارنده پایدار درون‌مکالمه است: هر پیام در یک تراکنش نوشتن با
// lastSeq+1 ثبت میشود؛ چون SQLite تراکنش‌های نوشتن را کامل سری‌سازی میکند،
// ترتیب seq دقیقاً همان ترتیب واقعی ارسال است — مبنای پایدار صفحه‌بندی و
// polling بدون هیچ اتکایی به ساعت کلاینت یا دقت میلی‌ثانیه createdAt.
//
// پایان ارتباط یا انقضای اشتراک این رکورد و پیام‌هایش را حذف نمیکند
// (سیاست شفاف پروژه: تاریخچه حفظ میشود، فقط ارسال جدید بسته میشود).

model CoachConversation {
  id            String                 @id @default(cuid())
  connectionId  String                 @unique
  studentId     String
  coachId       String
  // شمارنده پایدار پیام‌ها — در همان تراکنش نوشتن پیام افزایش مییابد
  lastSeq       Int                    @default(0)
  // زمان آخرین پیام — مرتب‌سازی فهرست مکالمه‌ها (null یعنی هنوز پیامی نیست)
  lastMessageAt DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  connection    CoachStudentConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  student       user                   @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  coach         user                   @relation("ConversationCoach", fields: [coachId], references: [id], onDelete: Cascade)
  messages      CoachMessage[]

  @@index([studentId, lastMessageAt])
  @@index([coachId, lastMessageAt])
}

// ----------------------------------------
// پیام خصوصی — رکورد تغییرناپذیر پس از نوشتن
// ----------------------------------------
// senderId همیشه از نشست سرور استخراج میشود و هر مقدار کلاینتی نادیده
// گرفته میشود. هیچ مسیر ویرایش یا حذف در این مرحله وجود ندارد (سیاست:
// تاریخچه مکالمه تغییرناپذیر است)؛ readAt فقط توسط سرور و فقط هنگام
// خواندن پیام‌های طرف مقابل توسط گیرنده مجاز ثبت میشود.
//
// unique(conversationId, seq) محافظ دوم در برابر هرگونه رقابت همزمانی
// است؛ رقابت با P2002 گرفته و با تلاش مجدد درون تراکنش حل میشود.
// محتوای پیام متن ساده است (بدون هیچ HTML ای) و در نمایش با escape امن
// React رندر میشود؛ سقف طول در اعتبارسنجی Zod سمت سرور اعمال میشود.

model CoachMessage {
  id             String            @id @default(cuid())
  seq            Int
  conversationId String
  senderId       String
  // متن ساده پیام — سقف کاراکتر در لایه اعتبارسنجی (CHAT_LIMITS.CONTENT_MAX)
  content        String
  // خوانده‌شدن — فقط گیرنده مجاز از مسیر سرور ثبت میکند (null = نخوانده)
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  conversation   CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         user              @relation("CoachMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  // پیوست فایل مرحله ۱۹.۶ — چند فایل به‌ازای هر پیام (سقف مجموع ۲۰MB سمت سرور)
  attachments    CoachMessageAttachment[]

  @@unique([conversationId, seq])
  @@index([senderId, createdAt])
}

// ----------------------------------------
// پیوست فایل پیام — مرحله ۱۹.۶
// ----------------------------------------
// هر پیام حداکثر یک فایل دارد (سقف مجموع ۲۰MB سمت سرور اعمال میشود).
// فایل روی دیسک خارج از public در data/uploads/chat/<conversationId> با نام
// تصادفی غیرکاربر ذخیره میشود؛ خواندن فقط از مسیر API مالکیت‌محور برای
// اعضای همان مکالمه. نوع فایل با امضای بایتها راستیآزمایی میشود (نه پسوند).

model CoachMessageAttachment {
  id          String       @id @default(cuid())
  messageId   String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime     @default(now())
  message     CoachMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

// ----------------------------------------
// مسدودسازی پیام‌رسان — مرحله ۱۹.۶
// ----------------------------------------
// مربی میتواند دانشجویی را که به او پیام میدهد مسدود کند: پس از مسدودسازی
// دانشجو نمیتواند به آن مربی پیام جدید بفرستد (بررسی سمت سرور در هر ارسال)،
// پیامهای قبلی و تاریخچه حفظ میشود و رابطه/اشتراک/برنامهها دستنخورده
// میمانند. رفع مسدودیت = حذف رکورد. در گفتوگوی اولیه (PENDING) و فعال
// (ACTIVE) رفتار یکسان است.

model ChatBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   user     @relation("ChatBlocksSet", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   user     @relation("ChatBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ----------------------------------------
// کتابخانه عمومی حرکات — مرحله ۱۸
// ----------------------------------------
// بانک واحد و مبتنی بر داده برای کل محصول: ۴۸ رکورد ویرایشی پروژه
// (sourceKey=editorial، همگام‌شده idempotent از فایل‌های TS) + رکوردهای
// منبع آزاد Free Exercise DB (sourceKey=free-exercise-db — Unlicense).
//
// قواعد ثابت:
//  - «id» شناسه پایدار است و هرگز تغییر نمی‌کند؛ ارتباط برنامه‌ها، جلسات
//    و مربی سه‌بعدی به همین شناسه است (تغییر نام حرکت رکوردهای قدیمی را
//    نمی‌شکند). رکوردهای منبع آزاد پیشوند «fbd-» دارند تا با شناسه‌های
//    ویرایشی برخورد نکنند.
//  - «مالکیت»، «منبع داده» و «وضعیت انتشار» سه فیلد جدا هستند و هرگز
//    با هم اشتباه گرفته نمی‌شوند (origin / sourceKey / publishState) —
//     زیرساخت مراحل ۱۹ و ۲۰؛ در این مرحله همه رکوردها origin=core و
//    publishState=none هستند و هیچ مسیر نوشتن عمومی‌ای وجود ندارد.
//  - پوشش سه‌بعدی صادقانه است: animation3dStatus فقط برای ۶ حرکت دارای
//    انیمیشن واقعی «ready» است؛ بقیه «none» و هیچ‌کدام به‌عنوان حرکت
//    سه‌بعدی پشتیبانی‌شده معرفی نمی‌شوند. نگاشت هر حرکت مستقل توسعه
//    می‌یابد (مرحله ۱۹).
//  - محتوای رکوردهای منبع آزاد به زبان اصلی منبع (en) ذخیره می‌شود و
//    فیلدهای بدون داده معتبر (تنفس/اشتباهات/ایمنی) خالی می‌مانند —
//    هیچ مقدار ساختگی‌ای نوشته نمی‌شود.
//  - import فقط با اسکریپت سمت سرور (scripts/p18-import-exercises.ts)،
//    idempotent و بر اساس unique(sourceKey, sourceRef) — اجرای دوباره
//    هرگز رکورد تکراری نمی‌سازد.

model Exercise {
  id                   String   @id
  // نام فارسی ویرایشی — null یعنی ترجمه موجود نیست (نمایش به انگلیسی می‌افتد)
  faName               String?
  enName               String
  // نام‌های جایگزین برای جست‌وجو — آرایه JSON رشته
  altNamesJson         String   @default("[]")
  // واژگان بانک: دسته ۱۱تایی، عضلات (۱۲ سه‌بعدی + ۳ کتابخانه‌ای)، تجهیزات ۱۴تایی
  category             String
  primaryMusclesJson   String   @default("[]")
  secondaryMusclesJson String   @default("[]")
  equipmentJson        String   @default("[]")
  // beginner | intermediate | advanced — در لایه نمایش به واژگان فارسی بانک ترجمه می‌شود
  difficulty           String
  // الگوی حرکتی — واژگان بانک (شامل stretch/other افزوده مرحله ۱۸)
  pattern              String
  // null یعنی منبع ساختار حرکت (compound/isolation) را مشخص نکرده — بدون حدس
  compound             Boolean?
  // نوع تمرین — عیناً از منبع: strength | stretching | plyometrics | powerlifting | olympic_weightlifting | strongman | cardio
  exerciseType         String   @default("strength")
  // محتوای آموزشی — به زبان contentLocale؛ فیلد بدون داده معتبر خالی می‌ماند
  summary              String   @default("")
  stepsJson            String   @default("[]")
  breathing            String?
  mistakesJson         String   @default("[]")
  safetyJson           String   @default("[]")
  // ترجمه نمایشی انگلیسی محتوا — فقط برای رکوردهای ویرایشی فارسی
  enContentJson        String?
  // fa (ویرایشی) | en (متن منبع) — نمایش با شفافیت کامل بر همین اساس است
  contentLocale        String   @default("fa")
  // منبع و مجوز — هر رکورد دقیقاً یک منبع دارد
  sourceKey            String   @default("editorial") // editorial | free-exercise-db
  sourceLicense        String   @default("proprietary-original") // proprietary-original | Unlicense
  // شناسه رکورد در منبع (برای free-exercise-db) / شناسه خود رکورد برای editorial
  sourceRef            String?
  datasetVersion       String?
  // وضعیت — آرشیو فقط با سیاست شفاف؛ حذف رکورد مجاز نیست (شناسه پایدار)
  status               String   @default("active") // active | archived
  // پوشش سه‌بعدی — مرحله ۱۹: همه حرکات فعال ready دارند؛ ۶ حرکت ویرایشی
  // قدیمی با coach3dId به بانک استاتیک وصل می‌مانند (رفتار قبلی حفظ می‌شود)
  // و بقیه با animation3dProfileId به الگوی حرکتی پارامتری متصل می‌شوند
  coach3dId            String?
  animation3dStatus    String   @default("none") // ready | needs_mapping | none
  animation3dProfileId String?
  // پارامترهای الگوی حرکتی (مرحله ۱۹) — JSON رشته؛ null برای ۶ حرکت legacy
  animation3dParamsJson String?
  // زیرساخت مراحل ۱۹/۲۰ — در این مرحله با مقادیر پیشفرض غیرفعال‌اند و
  // هیچ مسیر کلاینت‌محوری آن‌ها را تغییر نمی‌دهد
  videoStatus          String   @default("none") // none | missing | uploaded | processing
  // منشأ رکورد: core (کتابخانه پایه) | coach (مشارکت مربی — مرحله ۲۰)
  origin               String   @default("core")
  // مالک مربی — فقط برای origin=coach. مرحله ۲۰/P3: FK واقعی با SetNull —
  // تکمیل سیم‌کشی رزروشده فاز ۱۸؛ حذف حساب مربی رکورد منتشرشده را نگه میدارد (Q9)
  ownerUserId          String?
  owner                user?    @relation("ExerciseOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  // وضعیت انتشار مشارکتی — none | pending_review | published | recalled
  publishState         String   @default("none")
  importBatchId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  importBatch          ExerciseImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  // رسانه بانک عمومی — مرحله ۲۰/P2 (R2.3)؛ آپلود فقط ادمین
  media                ExerciseMedia[]

  @@unique([sourceKey, sourceRef])
  @@index([status, category])
  @@index([sourceKey, status])
  @@index([difficulty])
  @@index([pattern])
}

// دسته‌های import — شفافیت کامل عملیات: پذیرفته‌شده، تکراری، ردشده و گزارش
// کامل خطاها؛ اجرای دوباره import دسته جدید می‌سازد اما رکورد تکراری نمی‌سازد.
model ExerciseImportBatch {
  id             String    @id @default(cuid())
  sourceKey      String
  datasetVersion String
  license        String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  accepted       Int       @default(0)
  duplicates     Int       @default(0)
  rejected       Int       @default(0)
  updated        Int       @default(0)
  // گزارش کامل: رکوردهای ردشده با دلیل، موارد تکراری، پوشش نام فارسی و…
  reportJson     String    @default("{}")
  exercises      Exercise[]

  @@index([sourceKey, startedAt])
}

// ----------------------------------------
// مرحله ۱۹.۵ — درخواست ارتقای اشتراک FREE → PREMIUM
// ----------------------------------------
// هر کاربر حداکثر یک رکورد باز (pending) دارد؛ ردشده قابل ارسال مجدد است.
// تصمیم فقط سمت سرور با نقش ADMIN از دیتابیس گرفته می‌شود — هیچ مسیر
// کلاینتی tier را تغییر نمی‌دهد. اعطای نهایی PREMIUM همان منطق اشتراک
// (source="manual" + یادداشت شفاف) را استفاده می‌کند.
model PremiumUpgradeRequest {
  id          String    @id @default(cuid())
  userId      String    @unique
  // pending | approved | rejected
  status      String    @default("pending")
  // انگیزه درخواست کاربر — اختیاری، سقف طول در اعتبارسنجی
  message     String?
  decidedAt   DateTime?
  decidedBy   String? // شناسه ادمین — فقط ردیابی داخلی
  decidedNote String? // پاسخ شفاف ادمین به کاربر
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ----------------------------------------
// مرحله ۱۹.۵ — مرکز پشتیبانی — تیکت مشکلات کاربران
// ----------------------------------------
// چرخه وضعیت (فقط سمت سرور):
//   open -> answered     (پاسخ ادمین)
//   answered -> resolved (بستن توسط ادمین یا خود کاربر)
//   open/answered -> closed (بستن توسط خود کاربر؛ پایان مسیر)
//   answered -> open     (بازگشایی توسط خود کاربر — یک‌بار مجاز)
// تاریخچه هرگز حذف نمیشود؛ پاسخ ادمین متن ساده است (بدون HTML).
model SupportTicket {
  id        String    @id @default(cuid())
  userId    String
  // bug | account | subscription | coach | other
  category  String    @default("other")
  // خلاصه کوتاه — سقف طول در اعتبارسنجی
  subject   String
  // شرح کامل مشکل — سقف طول در اعتبارسنجی
  body      String
  // open | answered | resolved | closed
  status    String    @default("open")
  // پاسخ ادمین — متن ساده
  reply     String?
  repliedAt DateTime?
  repliedBy String?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ----------------------------------------
// مرحله ۱۹.۵ — گزارش اقدامات ادمین — فقط ردیابی، هرگز از کلاینت نمیآید
// ----------------------------------------
model AdminActionLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetType String
  targetId  String
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())
  admin     user     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

// ----------------------------------------
// مرکز اعلان‌ها — مرحله ۱۹.۶
// ----------------------------------------
// اعلان داخلی مبتنی بر رویدادهای واقعی پروژه. قید یکتای (userId, dedupeKey)
// ضدتکرار است: یک رویداد واحد هرگز دو اعلان نمیسازد (رقابت با P2002 گرفته
// و بیصدا نادیده گرفته میشود). readAt فقط سمت سرور ثبت میشود. هیچ ایمیل/
// Push ادعا نمیشود.

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  dedupeKey   String
  payloadJson String    @default("{}")
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

// ----------------------------------------
// یادداشت خصوصی مربی درباره دانشجو — مرحله ۱۹.۶
// ----------------------------------------
// هر جفت مربی-دانشجو حداکثر یک یادداشت (ویرایشپذیر). فقط مربی مالک میخواند
// و مینویسد؛ دانشجو، مربیان دیگر و کاربران عمومی هیچ دسترسیای ندارند و
// در هیچ API دیگری برگردانده نمیشود.

model CoachStudentNote {
  id        String   @id @default(cuid())
  coachId   String
  studentId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coach     user     @relation("CoachNotes", fields: [coachId], references: [id], onDelete: Cascade)
  student   user     @relation("StudentNotes", fields: [studentId], references: [id], onDelete: Cascade)

  // چند یادداشت مستقل برای هر جفت مربی/دانشجو — هر ذخیره رکورد جدید (مرحله ۲۰)
  @@index([coachId, studentId, createdAt])
  @@index([coachId, updatedAt])
}

// ----------------------------------------
// بانک حرکات شخصی مربی — مرحله ۱۹.۶
// ----------------------------------------
// کاملاً جدا از بانک عمومی ۹۰۵ حرکتی (Exercise). فقط مالک و مسیرهای مجاز
// سمت سرور میخوانند؛ هرگز وارد کتابخانه عمومی نمیشود و انیمیشن سهبعدی
// ندارد (صادقانه). برنامههای مربی snapshot محتوایی میگیرند؛ حذف حرکت
// شخصی نسخههای ارسالشده را نمیشکند (نامها در contentJson کپی شدهاند)
// و از حذف آبشاری ناخواسته جلوگیری میشود.

model CoachExercise {
  id                    String   @id @default(cuid())
  coachId               String
  // پوشه دستهبندی اختیاری — null یعنی بدون پوشه (بیرون از پوشهها)
  folderId              String?
  // مرحله ۲۰/P1 (R1.2): منشا حرکت شخصی از بانک عمومی — شناسه رکورد Exercise
  // هنگام «ذخیره از بانک» ثبت میشود؛ بدون FK سخت (رکوردهای بانک هرگز حذف
  // نمیشوند — فقط آرشیو) و هرگز به منبع وصل نمیماند (snapshot مستقل است).
  // برای حرکات ساختهشده از صفر null میماند.
  sourceExerciseId      String?
  faName                String
  enName                String
  category              String
  equipmentJson         String   @default("[]")
  primaryMusclesJson    String   @default("[]")
  secondaryMusclesJson  String   @default("[]")
  description           String   @default("")
  tips                  String   @default("")
  // سطح دشواری — واژگان بانک (beginner | intermediate | advanced). کارت بانک
  // برای نمایش به مقدار معتبر نیاز دارد؛ P3 این فیلد افزایشی را افزود تا
  // رکورد منتشرشده دقیق نمایش داده شود (بدون حدس سمت سرور).
  difficulty            String   @default("intermediate")
  // گردش کار انتشار — مرحله ۲۰/P3 (محور ۳، همان واژگان رزروشده فاز ۱۸):
  // none | pending_review | published | recalled — فقط با گذارهای سمت سرور
  publishState          String   @default("none")
  // زمان آخرین ارسال برای بازبینی — فقط تا لحظه تصمیم معنا دارد
  submittedAt           DateTime?
  // بازخورد آخرین رد ادمین — برای مربی نمایش داده میشود؛ با ارسال جدید پاک میشود
  reviewNote            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  coach                 user     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  folder                CoachExerciseFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  media                 CoachExerciseMedia[]

  @@index([coachId, updatedAt])
  @@index([coachId, folderId])
}

// پوشه دستهبندی حرکات شخصی مربی — مرحله ۲۰. فقط مالک میسازد/میبیند/حذف
// میکند؛ حذف پوشه هرگز حرکات را حذف نمیکند (SetNull — حرکات به «بدون پوشه»
// برمیگردند تا هیچ دادهای از دست نرود و برنامههای قدیمی سالم بمانند).
model CoachExerciseFolder {
  id        String   @id @default(cuid())
  coachId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coach     user     @relation("CoachExerciseFolders", fields: [coachId], references: [id], onDelete: Cascade)
  exercises CoachExercise[]

  @@unique([coachId, name])
  @@index([coachId, createdAt])
}

// ----------------------------------------
// گفتگوی آزاد بین هر دو کاربر — مرحله ۲۰ (بخش ۲ مشخصات)
// ----------------------------------------
// مستقل از ارتباط مربی/دانشجو؛ هر کاربر میتواند با هر کاربر دیگر گفتگو کند.
// جفت کاربران به‌صورت مرتب‌شده (userAId <= userBId لغتنامهای) ذخیره میشود
// تا هر جفت دقیقاً یک رشته داشته باشد (یکتایی در DB، ضد رقابت همزمان).
// مسدودی چت موجود (ChatBlock) اینجا هم سمت سرور اعمال میشود.
model DirectThread {
  id            String    @id @default(cuid())
  userAId       String    // همیشه شناسه کوچکتر لغتنامهای
  userBId       String    // همیشه شناسه بزرگتر لغتنامهای
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?
  userA         user      @relation("DirectThreadA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         user      @relation("DirectThreadB", fields: [userBId], references: [id], onDelete: Cascade)
  messages      DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

// پیام گفتگوی آزاد — حذف فیزیکی نداریم (تاریخچه حفظ)؛ متن حداکثر ۴۰۰۰.
model DirectMessage {
  id          String       @id @default(cuid())
  threadId    String
  senderId    String
  body        String
  createdAt   DateTime     @default(now())
  // زمانی که گیرنده رشته را باز کرد — پایه شمارش نخوانده
  readAt      DateTime?
  thread      DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      user         @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// رسانه حرکت شخصی — تصویر (JPEG/PNG/WebP ≤۵MB) یا ویدئو (MP4/WebM ≤۵۰MB)
// با امضای بایتها؛ فایل خارج از public با نام تصادفی، خواندن فقط مالک
// (و مسیرهای مجاز سرور) از API احراز هویتشده.

model CoachExerciseMedia {
  id          String        @id @default(cuid())
  exerciseId  String
  kind        String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime      @default(now())
  exercise    CoachExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, createdAt])
}

// ----------------------------------------
// رسانه حرکت بانک عمومی — مرحله ۲۰/P2 (R2.3)
// ----------------------------------------
// آینه CoachExerciseMedia برای رکوردهای بانک عمومی (Exercise)؛ فقط برای
// رکوردهای origin=core و status=active و فقط با آپلود ادمین. فایل خارج
// از public با نام تصادفی از لایه storage-provider ذخیره میشود؛ سرو فقط
// از مسیر API با نشست معتبر (همان قواعد دید بانک عمومی) — هیچ دسترسی
// عمومی بدون احراز هویت. ویدئو videoStatus رکورد را uploaded میکند؛
// این فیلد طبق قرارداد فاز ۱۸ هرگز به کلاینت نمیرسد (whitelist).
// هیچ رکورد بانک حذف نمیشود؛ حذف رسانه فقط فایل رسانه را پاک میکند.

model ExerciseMedia {
  id          String   @id @default(cuid())
  exerciseId  String
  kind        String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime @default(now())
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, createdAt])
}

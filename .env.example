# ------------------------------------------------------------
# AI Fitness Coach — نمونه متغیرهای محیطی (بدون هیچ مقدار محرمانه)
# مقادیر واقعی فقط در .env روی سرور نگهداری می‌شود؛ .env هرگز commit نمی‌شود.
# برای تولید BETTER_AUTH_SECRET:  openssl rand -base64 32
# ------------------------------------------------------------

# مسیر مطلق فایل SQLite — مطلق بنویسید تا به working directory وابسته نباشد
DATABASE_URL=file:/absolute/path/to/db/custom.db

# کلید امضای نشست‌ها (اجباری در production؛ در نبود آن، حالت prod به‌صورت
# امن شکست می‌خورد و daemon-start.py آن را خودکار تولید و در .env می‌نویسد)
BETTER_AUTH_SECRET=

# پورت و آدرس اتصال سرور standalone (اختیاری)
PORT=3000
HOSTNAME=0.0.0.0

# ارائه‌دهنده مدل زبانی دستیار (اختیاری — مسیر داخلی z-ai-web-dev-sdk)
# بدون تنظیم، دستیار وضعیت «پیکربندی‌نشده» صادقانه نشان می‌دهد
AI_PROVIDER=zai
AI_TIMEOUT_MS=15000

# سقف‌های محدودسازی نرخ دستیار (اختیاری)
AI_RATE_PER_MIN=8
AI_RATE_PER_DAY=150
